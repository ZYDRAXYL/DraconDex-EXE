{
  "$schema": "./chain.schema.json",
  "chainVersion": "1.0.0",
  "org": "ZYDRAXYL",
  "self": "EXE",
  "branch": "claude/dracondex-multi-repo-arch-p3mw47",
  "repos": {
    "APP": {
      "repo": "DraconDex-APP",
      "role": "hub",
      "private": true,
      "owns": [
        ".claude/",
        "chain/",
        "docs/",
        "process/",
        "tools/"
      ],
      "releases": null,
      "versionSource": null
    },
    "SDB": {
      "repo": "DraconDex-SDB",
      "role": "schema",
      "private": false,
      "owns": [
        "schema/",
        "supabase/",
        "assets/",
        "generated/"
      ],
      "releases": "sdb-v*",
      "versionSource": "sdb.json#sdbVersion"
    },
    "EXE": {
      "repo": "DraconDex-EXE",
      "role": "app",
      "private": true,
      "owns": [
        "electron/"
      ],
      "releases": "v*",
      "versionSource": "package.json#version"
    },
    "APK": {
      "repo": "DraconDex-APK",
      "role": "app",
      "private": true,
      "owns": [
        "flutter/"
      ],
      "releases": "flutter-v*",
      "versionSource": "flutter/pubspec.yaml#version"
    },
    "PWA": {
      "repo": "DraconDex-PWA",
      "role": "build",
      "private": false,
      "owns": [
        "tools/",
        "shim/",
        "dist/"
      ],
      "releases": null,
      "versionSource": "package.json#version"
    },
    "PKG": {
      "repo": "DraconDex-PKG",
      "role": "content",
      "private": false,
      "owns": [
        "packages/",
        "index.json"
      ],
      "releases": "pkg-v*",
      "versionSource": "package.json#version"
    },
    "WEB": {
      "repo": "DraconDex-WEB",
      "role": "site",
      "private": false,
      "owns": [
        "*.html",
        "assets/"
      ],
      "releases": "mirror",
      "versionSource": null
    }
  },
  "chains": {
    "exe": [
      "APP",
      "SDB",
      "EXE",
      [
        "PKG",
        "WEB",
        "PWA"
      ]
    ],
    "apk": [
      "APP",
      "SDB",
      "APK",
      [
        "PKG",
        "WEB",
        "PWA"
      ]
    ],
    "pwa": [
      "APP",
      "SDB",
      [
        "EXE",
        "APK"
      ],
      "PWA",
      "WEB"
    ]
  },
  "edges": [
    {
      "from": "APP",
      "to": "SDB",
      "carries": "claude-tooling"
    },
    {
      "from": "APP",
      "to": "EXE",
      "carries": "claude-tooling"
    },
    {
      "from": "APP",
      "to": "APK",
      "carries": "claude-tooling"
    },
    {
      "from": "APP",
      "to": "PWA",
      "carries": "claude-tooling"
    },
    {
      "from": "APP",
      "to": "PKG",
      "carries": "claude-tooling"
    },
    {
      "from": "APP",
      "to": "WEB",
      "carries": "claude-tooling"
    },
    {
      "from": "SDB",
      "to": "EXE",
      "carries": "generated-schema"
    },
    {
      "from": "SDB",
      "to": "APK",
      "carries": "generated-schema"
    },
    {
      "from": "EXE",
      "to": "PKG",
      "carries": "package-targets"
    },
    {
      "from": "APK",
      "to": "PKG",
      "carries": "package-targets"
    },
    {
      "from": "EXE",
      "to": "WEB",
      "carries": "release-mirror"
    },
    {
      "from": "APK",
      "to": "WEB",
      "carries": "release-mirror"
    },
    {
      "from": "EXE",
      "to": "PWA",
      "carries": "app-source"
    },
    {
      "from": "APK",
      "to": "PWA",
      "carries": "app-source"
    },
    {
      "from": "PWA",
      "to": "WEB",
      "carries": "app-source"
    }
  ],
  "propagation": {
    "mode": "pull-request",
    "label": "chained-update",
    "tokenSecret": "CHAIN_TOKEN",
    "trailerPrefix": "Chained-From",
    "syncState": "chain/.chain-sync.json"
  }
}
